{
  "name": "@lockin90/ui",
  "version": "0.1.0",
  "description": "Performance 90 design-system components for the web (Next.js / React).",
  "license": "UNLICENSED",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "import": "./dist/admin.mjs",
      "require": "./dist/admin.cjs"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.mjs",
      "require": "./dist/components/*.cjs"
    },
    "./admin/*": {
      "types": "./dist/admin/*.d.ts",
      "import": "./dist/admin/*.mjs",
      "require": "./dist/admin/*.cjs"
    },
    "./marketing": {
      "types": "./dist/marketing.d.ts",
      "import": "./dist/marketing.mjs",
      "require": "./dist/marketing.cjs"
    },
    "./marketing/*": {
      "types": "./dist/marketing/*.d.ts",
      "import": "./dist/marketing/*.mjs",
      "require": "./dist/marketing/*.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "NODE_OPTIONS=--max-old-space-size=4096 tsup && node scripts/copy-assets.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@lockin90/tokens": "workspace:*"
  },
  "peerDependencies": {
    "next": ">=14",
    "next-intl": ">=3",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "next-intl": {
      "optional": true
    }
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild-plugin-preserve-directives": "^0.0.11",
    "happy-dom": "^20.9.0",
    "next": "^15.3.2",
    "storybook": "^10.4.1",
    "next-intl": "^4.11.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5",
    "vite": "^8.0.0"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
