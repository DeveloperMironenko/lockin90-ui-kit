{
  "name": "@lockin90/ui-native",
  "version": "1.0.0",
  "description": "LockIn90 \"Aurora Flux\" React Native component library — StyleSheet primitives driven by @lockin90/tokens.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeveloperMironenko/lockin90-ui-kit.git",
    "directory": "packages/ui-native"
  },
  "source": "./src/index.ts",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/index.d.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js"
    }
  },
  "files": [
    "src",
    "lib",
    "!src/stories",
    "!lib/**/stories"
  ],
  "scripts": {
    "build": "node scripts/gen-stories-index.mjs && bob build",
    "gen:stories": "node scripts/gen-stories-index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "storybook": "storybook dev -p 6007 --no-open",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "@react-native-community/datetimepicker": ">=7",
    "expo-blur": ">=12",
    "expo-clipboard": ">=6",
    "expo-document-picker": ">=12",
    "expo-linear-gradient": ">=13",
    "react": ">=18",
    "react-native": ">=0.74",
    "react-native-svg": ">=15"
  },
  "peerDependenciesMeta": {
    "expo-clipboard": {
      "optional": true
    },
    "expo-blur": {
      "optional": true
    },
    "expo-document-picker": {
      "optional": true
    },
    "@react-native-community/datetimepicker": {
      "optional": true
    }
  },
  "dependencies": {
    "@lockin90/tokens": "workspace:*",
    "lucide-react-native": "^1.24.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^9.1.0",
    "@storybook/react-native-web-vite": "^9.1.0",
    "@types/react": "^19.0.0",
    "expo-linear-gradient": "^14.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-builder-bob": "^0.40.0",
    "react-native-svg": "^15.8.0",
    "react-native-web": "^0.21.0",
    "storybook": "^9.1.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
