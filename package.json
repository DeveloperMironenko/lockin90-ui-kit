{
  "name": "lockin90-ui-kit",
  "version": "0.0.0",
  "private": true,
  "description": "LockIn90 (LockIn90 / LockIn90) cross-platform design system \u2014 @lockin90/tokens, @lockin90/ui, @lockin90/ui-native.",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "storybook": "pnpm --filter @lockin90/ui storybook",
    "storybook:native": "pnpm --filter @lockin90/ui-native storybook",
    "storybook:all": "pnpm --parallel --filter @lockin90/ui --filter @lockin90/ui-native storybook",
    "build-storybook": "pnpm --filter @lockin90/ui build-storybook",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && node scripts/publish.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "overrides": {
      "vite": "^8.0.0",
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "esbuild": "^0.27.0"
    }
  }
}
